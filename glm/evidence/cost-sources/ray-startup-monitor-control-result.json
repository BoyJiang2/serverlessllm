    "source": "import pathlib,json,hashlib,subprocess,time\nrun='sllm-debug-20261109T170530Z-0cd21c3d';root=pathlib.Path('/data/brick1/boyjiang/glm5.1-fp8/debug')/run\nfiles={}\ndef read(name):\n p=root/name;b=p.read_bytes();files[name]={'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()};return json.loads(b)\nresult=read('controller-result.json');start=read('controller-start.json');stack=read('stack.json')\nunit=dict(x.split('=',1) for x in subprocess.check_output(['systemctl','show',run+'-controller.service','-p','MainPID,Result,ExecMainCode,ExecMainStatus,ExecMainStartTimestampMonotonic,ExecMainExitTimestampMonotonic,InvocationID,ExecStart,ActiveState,SubState'],text=True).splitlines())\nassert unit['MainPID']=='0' and unit['Result']=='success' and unit['ExecMainStatus']=='0'\nbegin=int(unit['ExecMainStartTimestampMonotonic'])*1000;end=int(unit['ExecMainExitTimestampMonotonic'])*1000\nassert 0<end-begin<=900*10**9 and result['success'] is True and result['publish_controller'] is False and result['model_service_pass'] is False\nfor role in ('worker','head'):\n e=result['exit_evidence'][role];assert e['normal_exit_verified'] and not e['final']['OOMKilled']\n assert not subprocess.check_output(['docker','ps','-aq','--no-trunc','--filter','id='+e['container_id']],text=True).strip()\nassert result['exit_evidence']['worker']['final']['ExitCode']==0 and not result.get('monitor_errors')\nout={'scope':'independent startup-control verification only; not GLM model service or controller supplement','run_id':run,'code_commit':'04fbc526546bb6776951019a24abc0405a3fd72a','unit':unit,'unit_elapsed_s':(end-begin)/1e9,'monitor':{},'release':{}}\nfor name,dest in [('controller-monitor.jsonl','monitor'),('release60.jsonl','release')]:\n p=root/name;b=p.read_bytes();a=[json.loads(x) for x in b.splitlines()];files[name]={'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}\n points=[x['monotonic_ns'] for x in a];spans=[(x['sample_end_ns']-x['sample_begin_ns'])/1e9 for x in a]\n assert len(a)>1 and all(begin<=x<=end for x in points) and max(spans)<=5 and all(0<y-x<=5*10**9 for x,y in zip(points,points[1:]))\n assert all(not x['gpu_processes'].strip() and all(int(line.split(',')[3].strip().split()[0])==0 for line in x['gpu'].splitlines()) for x in a)\n assert all(all(not int(line.split()[1]) for line in x['private_slice_memory_events'].splitlines() if line.split()[0].startswith('oom')) for x in a)\n if dest=='release':\n  assert (points[-1]-points[0])/1e9>=60 and abs((points[-1]-points[0])/1e9-result['release_observation_s'])<1e-6\n  assert all(all(y.get('absent') for y in x['containers'].values()) for x in a)\n stages={}\n for row in a:\n  for label,t0,t1 in row['stage_timings_ns']:stages[label]=max(stages.get(label,0),(t1-t0)/1e9)\n out[dest]={'samples':len(a),'span_s':(points[-1]-points[0])/1e9,'maximum_sample_s':max(spans),'maximum_gap_s':max(y-x for x,y in zip(points,points[1:]))/1e9,'stage_maximum_s':stages}\nproof_path=pathlib.Path('/run')/run/'guard-verification.json';raw=proof_path.read_bytes();proof=json.loads(raw)\nassert proof_path.stat().st_uid==0 and proof_path.stat().st_mode&0o222==0 and proof['holder']==start['holder'] and proof['deadline_delay_seconds']==900\nassert start['independent_controller_unit']['InvocationID']==unit['InvocationID']\nout['guard']={'root_proof_path':str(proof_path),'sha256':hashlib.sha256(raw).hexdigest(),'deadline_delay_s':proof['deadline_delay_seconds'],'deadline_after_main_s':(int(proof['deadline_next_monotonic_usec'])*1000-begin)/1e9,'accuracy':subprocess.check_output(['systemctl','show',run+'-deadline.timer','-p','AccuracyUSec,NextElapseUSecMonotonic'],text=True),'arm_to_main_s':(begin-proof['armed_ns'])/1e9}\nassert 0<out['guard']['deadline_after_main_s']<=900\n(root/'guard-verification-preserved.json').write_bytes(raw);files['guard-verification-preserved.json']={'path':str(root/'guard-verification-preserved.json'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}\nworker=read('debug-service/result.json');nodes=read('debug-service/ray-nodes.json')\nassert result['startup_stage']=='ray' and start['r1_sha256']=='35ed241f8226ba26bb5397ce4771beedf2053facdeeb7517a7d576e5e5db4e87'\nassert result['worker_control']==worker and worker['ray_control_pass'] is True and worker['success'] is False and worker['pool_bytes']==0\nassert sorted(x['Resources'].get('GPU',0) for x in nodes)==[0,8] and len({x['NodeID'] for x in nodes})==2\nassert not worker['shutdown_errors'] and not worker['forced_kill'] and worker['ray_cli_controlled_hook_evidence']\nlog=root/'debug-service/ray-worker.log';data=log.read_bytes();digest=hashlib.sha256(data).hexdigest()\nassert digest==worker['shutdown_log_sha256']['ray-worker']\nfiles['debug-service/ray-worker.log']={'path':str(log),'bytes':len(data),'sha256':digest}\nassert not (root/'controller-monitor-rejected.json').exists()\nout['ray_worker']=worker;out['ray_nodes']=nodes;out['result']=result;out['stack']=stack;out['files']=files;out['success']=True;out['model_service_pass']=False;out['historical_slow_sample_root_cause']='unresolved; no reproduction in this one Ray startup control'\np=root/'ray-independent-verification.json';b=(json.dumps(out,indent=2)+'\\n').encode();p.write_bytes(b);print(json.dumps({'path':str(p),'sha256':hashlib.sha256(b).hexdigest(),'unit_elapsed_s':out['unit_elapsed_s'],'monitor':out['monitor'],'release':out['release'],'guard':out['guard']}))\n",

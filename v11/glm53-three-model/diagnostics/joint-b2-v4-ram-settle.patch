+def settle_v4_wake_ram(step, first, required, runtime_stop, deadline):
+    """Check for three consecutive in-range samples without dispatching a wake."""
+    cutoff = min(deadline, first['ns'] + 30 * 10**9)
+    samples = [first]
+    streak = 0
+    while samples[-1]['available_bytes'] >= runtime_stop:
+        if cutoff - time.monotonic_ns() <= 2 * 10**9:
+            break
+        time.sleep(2)
+        stamp = time.monotonic_ns()
+        if stamp >= cutoff:
+            break
+        sample = dict(available_bytes=available_bytes(), ns=stamp)
+        samples.append(sample)
+        streak = streak + 1 if sample['available_bytes'] >= required else 0
+        if streak == 3:
+            break
+    write(step / 'host-admission-settle.json', dict(
+        samples=samples, required_bytes=required, runtime_stop_bytes=runtime_stop,
+        cutoff_ns=cutoff, required_consecutive=3, qualified=streak == 3))
+    return samples[-1] if streak == 3 else None



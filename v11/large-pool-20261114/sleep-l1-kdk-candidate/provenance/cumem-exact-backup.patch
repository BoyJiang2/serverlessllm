+class _ExactPinnedBackup:
+    """Own one page-rounded host mapping outside PyTorch's pinned cache."""
+
+    device = torch.device("cpu")
+
+    def __init__(self, size: int):
+        register = libcudart.lib.cudaHostRegister
+        register.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint]
+        register.restype = ctypes.c_int
+        unregister = libcudart.lib.cudaHostUnregister
+        unregister.argtypes = [ctypes.c_void_p]
+        unregister.restype = ctypes.c_int
+        mapping = mmap.mmap(-1, size, flags=mmap.MAP_PRIVATE | mmap.MAP_ANONYMOUS)
+        try:
+            pointer = ctypes.addressof(ctypes.c_char.from_buffer(mapping))
+            libcudart.CUDART_CHECK(register(pointer, size, 0))
+        except BaseException:
+            mapping.close()
+            raise
+        self._mapping = mapping
+        self._pointer = pointer
+        self._size = size
+        self._unregister = unregister
+        self._registered = True
+
+    def data_ptr(self) -> int:
+        return self._pointer
+
+    def numel(self) -> int:
+        return self._size
+
+    def element_size(self) -> int:
+        return 1
+
+    def close(self) -> None:
+        if self._registered:
+            libcudart.CUDART_CHECK(self._unregister(self._pointer))
+            self._registered = False
+        self._mapping.close()
+

--- candidate13b/cache_state_control13.py
+++ candidate13c/cache_state_control13.py
@@ -0,0 +1,123 @@
+import sys,os
+if sys.flags.optimize or os.environ.get('PYTHONOPTIMIZE'): raise RuntimeError('optimized Python is forbidden')
+"""File-specific cache preparation with full mincore vectors, outside timing."""
+import ctypes
+import datetime
+import gzip
+import hashlib
+import json
+import os
+import pathlib
+import sys
+import time
+from resource_window_control13 import load_window
+from cache_contract13 import frozen_paths
+from cache_repair_v9 import repair_hot
+from cache_prepare_v8 import prepare_hot_placement, numa_receipt
+from cache_prepare_v6 import read_hot, wait_read_idle, HOT_WORKERS, BUFFER_BYTES
+
+root = pathlib.Path('/experiment')
+manifest = json.loads((root/'run-manifest.json').read_text())
+deadline = datetime.datetime.fromisoformat(load_window(root)['cleanup_deadline']).timestamp()
+mode, kind, label = sys.argv[1:]
+assert mode in ('cold', 'hot', 'check') and kind in ('weights', 'metadata', 'safetensors_inputs', 'store_inputs')
+assert label.replace('_', '').isalnum()
+base = root/'checkpoint'
+assert mode == 'hot' and kind == 'safetensors_inputs' and label == 'g1hot13', 'only frozen G1 control allowed'
+control = pathlib.Path(__file__).resolve().parent
+paths = frozen_paths(base, control/'cache-inputs13.json')
+dest = control / ('cache_' + label)
+dest.mkdir(exist_ok=False)
+libc = ctypes.CDLL(None, use_errno=True)
+libc.mmap.restype = ctypes.c_void_p
+libc.mmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_long]
+libc.mincore.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p]
+libc.munmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
+page_size = os.sysconf('SC_PAGE_SIZE')
+lsb = bytes(value & 1 for value in range(256))
+rows = []
+preparation_begin_ns = time.monotonic_ns()
+numa_before = numa_receipt()
+(dest/'before-placement.json').write_text(json.dumps(numa_before,indent=2))
+placement = prepare_hot_placement(paths,root,numa_before['node_meminfo'],dest) if mode == 'hot' else None
+parallel_rows = read_hot(paths) if mode == 'hot' else []
+if placement is not None:
+    assert all(row['cpu_begin'] in placement['reader_cpu_affinity'] and row['cpu_end'] in placement['reader_cpu_affinity'] for row in parallel_rows)
+read_threads_joined_ns = time.monotonic_ns()
+with (dest/'preparation.jsonl').open('x') as preparation:
+    for item in parallel_rows:
+        preparation.write(json.dumps(item)+'\n')
+    for path in ([] if mode == 'hot' else paths):
+        if time.time() >= deadline - 120:
+            raise TimeoutError('cache preparation deadline reached')
+        size = path.stat().st_size
+        with path.open('rb') as source:
+            if mode == 'cold':
+                os.posix_fadvise(source.fileno(), 0, size, os.POSIX_FADV_DONTNEED)
+        preparation.write(json.dumps({'file':str(path),'mode':mode,
+                                      'complete_monotonic_ns':time.monotonic_ns()})+'\n')
+read_idle_receipt = wait_read_idle(deadline) if mode == 'hot' else []
+numa_after = numa_receipt()
+preparation_complete_ns = time.monotonic_ns()
+# Admission uses a separate full-list pass after all preparation has completed.
+# Later reads can evict earlier files; per-file checks during warming cannot prove
+# that the complete input set remains resident at the startup boundary.
+verification_begin_ns = time.monotonic_ns()
+for path in paths:
+    if time.time() >= deadline - 120:
+        raise TimeoutError('cache preparation deadline reached')
+    size = path.stat().st_size
+    with path.open('rb') as source:
+        count = (size+page_size-1)//page_size
+        address = libc.mmap(None, size, 0, 2, source.fileno(), 0)  # PROT_NONE, MAP_PRIVATE
+        assert address != ctypes.c_void_p(-1).value, os.strerror(ctypes.get_errno())
+        try:
+            vector = (ctypes.c_ubyte*count)()
+            assert libc.mincore(address, size, vector) == 0, os.strerror(ctypes.get_errno())
+            flags = bytes(vector)
+        finally:
+            assert libc.munmap(address, size) == 0
+    resident = flags.translate(lsb).count(b'\x01')
+    relative = path.relative_to(base).as_posix() if path.is_relative_to(base) else 'source_metadata/'+path.name
+    vector_name = relative+'.mincore.gz'
+    (dest/vector_name).parent.mkdir(parents=True,exist_ok=True)
+    (dest/vector_name).write_bytes(gzip.compress(flags, compresslevel=1, mtime=0))
+    row = {'file': relative, 'source_path':str(path), 'bytes': size, 'pages': count, 'resident_pages': resident,
+           'page_size': page_size, 'vector': vector_name, 'vector_sha256': hashlib.sha256(flags).hexdigest()}
+    rows.append(row)
+    print(json.dumps(row), flush=True)
+repair_history = []
+initial_preparation_complete_ns = preparation_complete_ns
+initial_verification_begin_ns = verification_begin_ns
+initial_verification_complete_ns = time.monotonic_ns()
+if mode == 'hot':
+    (dest/'initial-scan.json').write_text(json.dumps(dict(files=rows,verification_begin_ns=verification_begin_ns,
+        verification_complete_ns=initial_verification_complete_ns,read_threads_joined_ns=read_threads_joined_ns,
+        read_idle_receipt=read_idle_receipt),indent=2))
+    rows,repair_history = repair_hot(paths,base,dest,rows,set(placement['reader_cpu_affinity']),preparation_begin_ns,deadline)
+    if repair_history:
+        preparation_complete_ns = repair_history[-1]['read_threads_joined_ns']
+        verification_begin_ns = repair_history[-1]['verification_begin_ns']
+verification_complete_ns = repair_history[-1]['verification_complete_ns'] if repair_history else initial_verification_complete_ns
+passed = all(row['resident_pages'] == (0 if mode == 'cold' else row['pages']) for row in rows) if mode != 'check' else None
+summary = {'mode': mode, 'kind': kind, 'files': rows, 'cache_condition_passed': passed,
+           'protocol_revision':'G1-candidate13c','resource_window_revision':'v3','input_manifest_sha256':hashlib.sha256((control/'cache-inputs13.json').read_bytes()).hexdigest(),'preparation_revision':'store_node0_hot_bounded_repair_10','hot_placement':placement,
+           'repair_history':repair_history,'repair_passes':len(repair_history),'initial_preparation_complete_ns':initial_preparation_complete_ns,
+           'hot_workers':HOT_WORKERS,'read_buffer_bytes_per_worker':BUFFER_BYTES,
+           'read_threads_joined_ns':read_threads_joined_ns,'read_idle_receipt':read_idle_receipt,
+           'numa_before':numa_before,'initial_numa_after':numa_after,'final_numa_after':numa_receipt(),
+           'preparation_begin_ns':preparation_begin_ns,
+           'preparation_complete_ns':preparation_complete_ns,
+           'verification_begin_ns':verification_begin_ns,
+           'verification_complete_ns':verification_complete_ns,
+           'initial_verification_begin_ns':initial_verification_begin_ns,'initial_verification_complete_ns':initial_verification_complete_ns,
+           'total_cache_admission_begin_ns':preparation_begin_ns,'total_cache_admission_end_ns':time.monotonic_ns(),
+           'timing_scope':'total admission includes initial read and scan plus all repair reads and scans; nested intervals are not additive; top verification is the final full scan',
+           'scope': 'Linux host page cache for exactly listed files; not hardware/storage/CUDA/JIT caches',
+           'utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
+(dest/'summary.json').write_text(json.dumps(summary, indent=2))
+if mode != 'check':
+    assert passed, 'mincore failed the declared cache condition; retain failed preparation'
+
+
+

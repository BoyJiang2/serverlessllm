+        entries=[o for o in spec['overlays'] if o['target']==target]
+        assert len(entries)<=1
+        source=module['output']['path'];digest=module['output']['sha256']
+        if entries:
+            old=entries[0]['source'];spec['code_pins'].pop(old,None)
+            entries[0].update(source=source,sha256=digest)
+        else:spec['overlays'].append({'source':source,'target':target,'sha256':digest})
+        for request in spec['requests'].values():
+            mounts=[m for m in request['mounts'] if m['Target']==target]
+            assert len(mounts)<=1 and (not mounts or mounts[0]['ReadOnly'] is True)
+            if mounts:mounts[0]['Source']=source

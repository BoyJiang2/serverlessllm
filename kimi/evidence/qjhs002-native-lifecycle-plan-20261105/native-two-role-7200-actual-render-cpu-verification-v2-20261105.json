  "actual_root_generator_AST": "def validate_role_contracts():\n    for (name, body) in s['role_bodies'].items():\n        assert hashlib.sha256(body.encode()).hexdigest() == s['role_body_sha256'][name]\n    tree = ast.parse(s['role_bodies']['bootstrap'])\n    target = next((n.value for n in ast.walk(tree) if isinstance(n, ast.Assign) and any((isinstance(t, ast.Name) and t.id == 'target' for t in n.targets))))\n    assert isinstance(target, ast.Call) and ast.literal_eval(target.args[0]) == '/usr/local/lib/python3.12/dist-packages'\n    assert '/evidence' not in s['role_bodies']['bootstrap'] and '--target' in s['role_bodies']['bootstrap'] and ('--break-system-packages' not in s['role_bodies']['bootstrap']) and ('--upgrade' not in s['role_bodies']['bootstrap'])\n    assert all((req['env']['VLLM_ALLOW_INSECURE_SERIALIZATION'] == '0' for req in s['requests'].values()))\n\ndef create_argv(role):\n    validate_role_contracts()\n    req = s['requests'][role]\n    h = req['host_config']\n    a = D + ['create', '--name', req['name'], '--network=' + network, '--runtime=' + h['Runtime'], '--user=2147:2147', '--workdir=/source', '--cpus=' + str(h['NanoCpus'] / 1000000000.0), '--memory=' + str(h['Memory']), '--memory-swap=' + str(h['MemorySwap']), '--pids-limit=4096', '--shm-size=' + str(h['ShmSize']), '--tmpfs=/tmp:rw,exec,nosuid,nodev,size=8g,mode=1777', '--cap-drop=ALL', '--security-opt=no-new-privileges', '--ulimit=core=0', '--log-driver=json-file', '--log-opt=max-size=64m', '--log-opt=max-file=1']\n    for (k, v) in req['env'].items():\n        a += ['--env', k + '=' + v]\n    mounts = req['mounts'] + [{'Source': str(control), 'Target': '/control', 'ReadOnly': True}, {'Source': str(base / role), 'Target': '/evidence', 'ReadOnly': False}]\n    for q in mounts:\n        a += ['--mount', 'type=bind,src=' + q['Source'] + ',dst=' + q['Target'] + (',readonly' if q['ReadOnly'] else '')]\n    assert req['cmd'] == ['-I', '-c', s['role_bodies']['pid1']] and hashlib.sha256(req['cmd'][-1].encode()).hexdigest() == s['role_body_sha256']['pid1']\n    return (a + ['--entrypoint=' + req['entrypoint'], s['image'], *req['cmd']], mounts)\n\ndef create_arm_start(role):\n    assert time.monotonic() - started < (90 if role == 'head' else 600)\n    (argv, mounts) = create_argv(role)\n    cid = call(argv, 10).strip()\n    assert re.fullmatch('[0-9a-f]{64}', cid)\n    cids[role] = cid\n    row = inspect(role)\n    req = s['requests'][role]\n    h = row['HostConfig']\n    assert row['Image'] == s['image'] and row['State']['Status'] == 'created' and (row['Config']['User'] == '2147:2147') and (row['Config']['Cmd'] == req['cmd']) and (row['Config']['Entrypoint'] == [req['entrypoint']])\n    for k in ['Runtime', 'ReadonlyRootfs', 'Memory', 'MemorySwap', 'NanoCpus', 'PidsLimit', 'ShmSize', 'Tmpfs', 'CapDrop', 'SecurityOpt']:\n        assert h[k] == req['host_config'][k], k\n    assert h['NetworkMode'] == network and h['RestartPolicy']['Name'] == 'no' and ({(q['Source'], q['Destination'], q['RW']) for q in row['Mounts']} == {(q['Source'], q['Target'], not q['ReadOnly']) for q in mounts})\n    env = dict((x.split('=', 1) for x in row['Config']['Env']))\n    assert all((env[k] == v for (k, v) in req['env'].items())) and env['VLLM_ALLOW_INSECURE_SERIALIZATION'] == '0'\n    save(role + '-prepared.json', {'cid': cid, 'actual_create_argv': argv, 'role_body_sha256': s['role_body_sha256'], 'inspect': row})\n    b = s['budgets']['head_guard' if role == 'head' else 'worker_guard']\n    gb = base / ('guard-' + role)\n    unit = run + '-' + role + '-guard.service'\n    systemd(unit, ['/usr/bin/python3', str(guard), cid, str(gb), '--deadline', str(b['deadline']), '--kill-after', '3', '--overall', str(b['overall']), '--normal-exit-marker'], b['native'])\n    units[role] = unit\n    limit = time.monotonic() + 10\n    while not (gb / 'ARMED.json').exists():\n        assert time.monotonic() < limit\n        time.sleep(0.02)\n    ar = json.loads((gb / 'ARMED.json').read_text())\n    assert ar['cid'] == cid and identity(ar['guard_pid'])['startticks'] == ar['guard_startticks'] and (int(props(unit)['MainPID']) == ar['guard_pid'])\n    assert (ar['deadline_seconds'], ar['cleanup_seconds'], ar['release_seconds']) == (b['deadline'], b['overall'], 60)\n    arms[role] = ar\n    go = time.monotonic()\n    tmp = gb / 'GO.json.tmp'\n    tmp.write_text(json.dumps({'cid': cid, 'nonce': ar['nonce'], 'monotonic': go}))\n    os.replace(tmp, gb / 'GO.json')\n    limit = go + 2\n    while not (gb / 'GO-ACK.json').exists():\n        assert time.monotonic() < limit\n        time.sleep(0.02)\n    assert json.loads((gb / 'GO-ACK.json').read_text()) == {'cid': cid, 'go_monotonic': go}\n    call(D + ['start', cid], 10)\n    row = inspect(role)\n    assert row['State']['Running']\n    nets = list(row['NetworkSettings']['Networks'].values())\n    assert len(nets) == 1 and nets[0]['NetworkID'] == network\n    ips[role] = nets[0]['IPAddress']\n    assert ips[role]\n    save(role + '-started.json', {'inspect': row, 'go_monotonic': go, 'ip': ips[role]})\n\ndef exec_argv(role, body, args=(), uid='2147:2147', extra=None):\n    validate_role_contracts()\n    code = s['role_bodies'][body]\n    assert hashlib.sha256(code.encode()).hexdigest() == s['role_body_sha256'][body]\n    a = D + ['exec', '--user=' + uid, '--workdir=/source']\n    env = {'VLLM_HOST_IP': ips[role], 'RAY_ADDRESS': ips['head'] + ':6379', 'NATIVE_ROLE': body}\n    if extra:\n        env.update(extra)\n    for (k, v) in env.items():\n        a += ['--env', k + '=' + v]\n    assert (uid == '0') == (body == 'bootstrap')\n    return a + [cids[role], '/usr/bin/python3', '-I', '-c', code, *args]",
  "actual_controller_identity_AST": "def validate_controller_identity(row, actor_id, info, expected, startticks, cgroup, own_cgroup):\n    assert row == {'name': expected['name'], 'namespace': expected['namespace']} and row['name'] == 'controller'\n    assert actor_id == expected['actor_id'] and info['ActorID'] == actor_id and (info['State'] == 'ALIVE')\n    assert info['Name'] == 'controller' and info['Pid'] == expected['metadata']['Pid'] and (info['Address'] == expected['metadata']['Address'])\n    assert startticks == expected['host_identity']['startticks'] and cgroup == own_cgroup",

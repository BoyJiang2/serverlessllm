 sllm_store/vllm_patch/patch.sh                |  9 ++--
 2 files changed, 54 insertions(+), 3 deletions(-)
 create mode 100644 sllm_store/tests/python/test_vllm_patch_status.py

diff --git a/sllm_store/tests/python/test_vllm_patch_status.py b/sllm_store/tests/python/test_vllm_patch_status.py
new file mode 100644
index 0000000..9f03bc4
--- /dev/null
+++ b/sllm_store/tests/python/test_vllm_patch_status.py
@@ -0,0 +1,48 @@
+"""Exercise patch status with real patch(1), without importing vLLM."""
+import os
+import pathlib
+import subprocess
+import tempfile
+import unittest
+
+
+class PatchStatusTest(unittest.TestCase):
+    def test_unapplied_applied_and_conflict(self):
+        script = pathlib.Path(__file__).resolve().parents[2] / "vllm_patch/patch.sh"
+        with tempfile.TemporaryDirectory(prefix="sllm-patch-test-") as directory:
+            work = pathlib.Path(directory)
+            target = work / "package"
+            target.mkdir()
+            (work / "patch.sh").write_bytes(script.read_bytes())
+            (work / "sllm_load.patch").write_text(
+                "--- a/vllm/item.txt\n+++ b/vllm/item.txt\n"
+                "@@ -1 +1 @@\n-old\n+new\n")
+            python = work / "python"
+            python.write_text("#!/bin/sh\nprintf '%s\\n' '" + str(target) + "'\n")
+            python.chmod(0o700)
+            environment = dict(os.environ, PATH=str(work) + ":" + os.environ["PATH"])
+
+            def run():
+                return subprocess.run(["bash", str(work / "patch.sh")],
+                                      env=environment, capture_output=True,
+                                      text=True, timeout=10)
+
+            item = target / "item.txt"
+            item.write_text("old\n")
+            first = run()
+            self.assertEqual(first.returncode, 0, first.stdout + first.stderr)
+            self.assertEqual(item.read_text(), "new\n")
+            second = run()
+            self.assertEqual(second.returncode, 0, second.stdout + second.stderr)
+            self.assertIn("already been applied", second.stdout)
+            self.assertEqual(item.read_text(), "new\n")
+            item.write_text("foreign\n")
+            conflict = run()
+            self.assertNotEqual(conflict.returncode, 0)
+            self.assertIn("conflicts", conflict.stderr)
+            self.assertNotIn("already been applied", conflict.stdout)
+            self.assertEqual(item.read_text(), "foreign\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/sllm_store/vllm_patch/patch.sh b/sllm_store/vllm_patch/patch.sh
index c3a2166..7f10cc9 100755
--- a/sllm_store/vllm_patch/patch.sh
+++ b/sllm_store/vllm_patch/patch.sh
@@ -41,11 +41,14 @@ if [ ! -d "$VLLM_PATH" ]; then
 fi
 
 # Attempt a dry run of the patch to check if it's already applied
-if patch -p2 --dry-run -d "$VLLM_PATH" < "$PATCH_FILE"; then
+if patch --batch --forward --fuzz=0 -p2 --dry-run -d "$VLLM_PATH" < "$PATCH_FILE"; then
     echo "vLLM patch is not applied. Applying the patch now..."
     # Apply the patch
-    patch -p2 -d "$VLLM_PATH" < "$PATCH_FILE"
+    patch --batch --forward --fuzz=0 -p2 -d "$VLLM_PATH" < "$PATCH_FILE"
     echo "Patch applied successfully."
-else
+elif patch --batch --force -R --fuzz=0 -p2 --dry-run -d "$VLLM_PATH" < "$PATCH_FILE"; then
     echo "vLLM patch has already been applied. Skipping..."
+else
+    echo "Error: vLLM patch conflicts with this installation; compatibility is unverified." >&2
+    exit 1
 fi
\ No newline at end of file

  "role_bodies": {
    "bootstrap": "import hashlib,importlib.metadata as md,json,pathlib,subprocess,sys\nspec=json.loads(pathlib.Path('/control/spec.json').read_text());target=pathlib.Path('/usr/local/lib/python3.12/dist-packages');assert target.is_dir() and target.resolve()==target and pathlib.Path(md.distribution('torch').locate_file('')).resolve()==target\nfor name,module in [('ray','ray'),('msgpack','msgpack'),('GPUtil','GPUtil'),('speedtest-cli','speedtest.py')]:\n try:md.distribution(name)\n except md.PackageNotFoundError:pass\n else:raise AssertionError('new package distribution already exists: '+name)\n assert not (target/module).exists(),module\ndef core():\n result={}\n for name,module in [('torch','torch/__init__.py'),('vllm','vllm/__init__.py'),('transformers','transformers/__init__.py'),('grpcio','grpc/__init__.py')]:\n  dist=md.distribution(name);result[name]=dict(version=dist.version,metadata_sha256=hashlib.sha256(dist.read_text('METADATA').encode()).hexdigest(),record_sha256=hashlib.sha256(dist.read_text('RECORD').encode()).hexdigest(),module_sha256=hashlib.sha256(pathlib.Path(dist.locate_file(module)).read_bytes()).hexdigest())\n return result\nbefore=core();paths=[]\nfor a in spec['assets']:\n p=pathlib.Path('/assets')/a['filename'];assert p.stat().st_size==a['bytes'] and hashlib.sha256(p.read_bytes()).hexdigest()==a['sha256'];paths.append(str(p))\nargv=['/usr/bin/python3','-I','-m','pip','install','--no-index','--no-deps','--no-cache-dir','--disable-pip-version-check','--target',str(target),*paths];subprocess.run(argv,check=True,timeout=180);assert core()==before\nrecord={'status':'EXISTING_PREFIX_FOUR_WHEELS_INSTALLED_CORE_UNCHANGED','core_before_after':before,'assets':spec['assets'],'pip_version':md.version('pip'),'installed':{n:md.version(n) for n in ['ray','msgpack','GPUtil','speedtest-cli']},'argv':argv}\nprint('NATIVE_BOOTSTRAP_PASS '+json.dumps(record),flush=True)\n",
    "official_module": "import sys,os,json,pathlib,runpy\nsys.path[:0]=['/source','/source/sllm_store'];module=sys.argv[1];assert module in ['ray.scripts.scripts','sllm.cli.clic','sllm_store.cli'];role=os.environ.get('NATIVE_ROLE','command');\nif role=='api':\n import faulthandler,signal\n faulthandler.register(signal.SIGUSR1,all_threads=True,chain=False)\npathlib.Path('/evidence/'+role+'.pid').write_text(str(os.getpid()));print('NATIVE_OFFICIAL_ROLE '+json.dumps({'role':role,'pid':os.getpid(),'module':module,'argv':sys.argv[2:]}),flush=True);sys.argv=[module,*sys.argv[2:]];\nif module=='sllm_store.cli':\n import importlib\n importlib.import_module(module).main()\nelse:\n runpy.run_module(module,run_name='__main__')\n",
    "ray_state": "from google.protobuf.message import Message\nfrom google.protobuf.json_format import MessageToDict\n\ndef actor_metadata_json(value):\n    if isinstance(value, Message):\n        return MessageToDict(value, preserving_proto_field_name=True)\n    raise TypeError('Unsupported actor metadata JSON type: ' + type(value).__name__)\nimport ray, json, os\nfrom ray._private.state import actors\nray.init(address=os.environ['RAY_ADDRESS'], log_to_driver=False)\nrows = ray.util.list_named_actors(all_namespaces=True)\nmatches = [r for r in rows if r['name'] == 'controller']\nassert len(matches) <= 1\ncontroller = None\nif matches:\n    r = matches[0]\n    a = ray.get_actor(r['name'], namespace=r['namespace'])\n    controller = {**r, 'actor_id': a._actor_id.hex(), 'metadata': actors(actor_id=a._actor_id.hex())}\nprint(json.dumps({'nodes': ray.nodes(), 'named_actors': rows, 'controller': controller}, default=actor_metadata_json), flush=True)\nray.shutdown()\n",
    "controller_shutdown": "import ray,json,os,sys,pathlib\nfrom ray._private.state import actors\ndef validate_controller_identity(row,actor_id,info,expected,startticks,cgroup,own_cgroup):\n assert row=={'name':expected['name'],'namespace':expected['namespace']} and row['name']=='controller'\n assert actor_id==expected['actor_id'] and info['ActorID']==actor_id and info['State']=='ALIVE'\n assert info['Name']=='controller' and info['Pid']==expected['metadata']['Pid'] and info['Address']==expected['metadata']['Address']\n assert startticks==expected['host_identity']['startticks'] and cgroup==own_cgroup\nray.init(address=os.environ['RAY_ADDRESS'],log_to_driver=False);expected=json.loads(sys.argv[1]);rows=[r for r in ray.util.list_named_actors(all_namespaces=True) if r['name']=='controller'];assert len(rows)==1;row=rows[0];actor=ray.get_actor(row['name'],namespace=row['namespace']);info=actors(actor_id=actor._actor_id.hex());proc=pathlib.Path('/proc')/str(info['Pid']);startticks=int((proc/'stat').read_text().rsplit(')',1)[1].split()[19]);validate_controller_identity(row,actor._actor_id.hex(),info,expected,startticks,(proc/'cgroup').read_text(),pathlib.Path('/proc/self/cgroup').read_text());ray.get(actor.shutdown.remote(),timeout=120);print('NATIVE_CONTROLLER_SHUTDOWN_PASS',flush=True);ray.shutdown()\n",
    "http": "import json,sys,urllib.request,time\npath=sys.argv[1];payload=json.loads(sys.argv[2]);timeout=float(sys.argv[3]);url='http://127.0.0.1:8343'+path;data=None if payload is None else json.dumps(payload).encode();request=urllib.request.Request(url,data=data,headers={'Content-Type':'application/json'});started=time.monotonic()\nwith urllib.request.urlopen(request,timeout=timeout) as response:raw=response.read((1<<20)+1);assert len(raw)<=1<<20;value=json.loads(raw);status=response.status\nprint(json.dumps({'status':status,'response':value,'elapsed':time.monotonic()-started}),flush=True)\n"

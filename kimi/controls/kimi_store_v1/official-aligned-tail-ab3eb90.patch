From ab3eb90ffe197002d75aae5e0057a235db60282d Mon Sep 17 00:00:00 2001
From: Boy Jiang <2352027372@qq.com>
Date: Tue, 3 Nov 2026 16:17:28 +0800
Subject: [PATCH] Fix aligned tensor tail persistence and partition offsets

---
 sllm_store/csrc/checkpoint/aligned_buffer.cpp | 10 ++-
 sllm_store/csrc/checkpoint/tensor_writer.cpp  |  3 +
 sllm_store/tests/cpp/test_tensor_writer.py    | 70 +++++++++++++++++++
 3 files changed, 82 insertions(+), 1 deletion(-)
 create mode 100644 sllm_store/tests/cpp/test_tensor_writer.py

diff --git a/sllm_store/csrc/checkpoint/aligned_buffer.cpp b/sllm_store/csrc/checkpoint/aligned_buffer.cpp
index 4b93340..932ddc9 100644
--- a/sllm_store/csrc/checkpoint/aligned_buffer.cpp
+++ b/sllm_store/csrc/checkpoint/aligned_buffer.cpp
@@ -20,6 +20,7 @@
 #include <fcntl.h>
 #include <unistd.h>
 
+#include <cstdlib>
 #include <cstring>
 #include <iostream>
 
@@ -35,7 +36,14 @@ AlignedBuffer::AlignedBuffer(const std::string& filename)
 AlignedBuffer::~AlignedBuffer() {
   // if the buffer is not written to file, write it to file
   if (buffer_ && buf_pos_) {
-    pwrite(fd_, buffer_, buf_pos_, file_offset_);
+    size_t aligned_size = (buf_pos_ + kAlignment - 1) / kAlignment * kAlignment;
+    memset(static_cast<char*>(buffer_) + buf_pos_, 0, aligned_size - buf_pos_);
+    if (pwrite(fd_, buffer_, aligned_size, file_offset_) != aligned_size ||
+        ftruncate(fd_, file_offset_ + aligned_size) != 0) {
+      std::cerr << "Failed to flush aligned tensor tail, errno: " << errno
+                << std::endl;
+      std::abort();
+    }
   }
   if (buffer_) {
     free(buffer_);
diff --git a/sllm_store/csrc/checkpoint/tensor_writer.cpp b/sllm_store/csrc/checkpoint/tensor_writer.cpp
index 46eb304..ad84009 100644
--- a/sllm_store/csrc/checkpoint/tensor_writer.cpp
+++ b/sllm_store/csrc/checkpoint/tensor_writer.cpp
@@ -26,6 +26,9 @@ TensorWriter::~TensorWriter() {}
 uint64_t TensorWriter::writeRecord(const char* data, size_t size) {
   if (partition_idx_ == -1 || partition_size_ + size > kPartitionMaxSize) {
     // create a new partition
+    if (partition_idx_ != -1) {
+      offset_ += (kAlignment - partition_size_ % kAlignment) % kAlignment;
+    }
     partition_idx_++;
     partition_size_ = 0;
     std::string partition_filename =
diff --git a/sllm_store/tests/cpp/test_tensor_writer.py b/sllm_store/tests/cpp/test_tensor_writer.py
new file mode 100644
index 0000000..81c2edb
--- /dev/null
+++ b/sllm_store/tests/cpp/test_tensor_writer.py
@@ -0,0 +1,70 @@
+"""CPU regression for the official writer; no Torch/CUDA or downloads.
+
+Run: python3 sllm_store/tests/cpp/test_tensor_writer.py
+The partition test copies only the writer sources into a temporary directory
+and reduces kPartitionMaxSize to 8192 bytes. It is a boundary fixture,
+not a real 10 GiB partition or model conversion test.
+"""
+import pathlib
+import subprocess
+import tempfile
+import unittest
+
+
+class TensorWriterTest(unittest.TestCase):
+    def test_tail_and_partition_offsets(self):
+        root = pathlib.Path(__file__).resolve().parents[2] / "csrc/checkpoint"
+        with tempfile.TemporaryDirectory(prefix="sllm-writer-test-") as directory:
+            work = pathlib.Path(directory)
+            for name in ("aligned_buffer.cpp", "aligned_buffer.h",
+                         "tensor_writer.cpp", "tensor_writer.h"):
+                (work / name).write_bytes((root / name).read_bytes())
+            header = work / "tensor_writer.h"
+            text = header.read_text()
+            self.assertIn("10L << 30", text)
+            header.write_text(text.replace("10L << 30", "8192"))
+            (work / "test.cpp").write_text(r"""
+#include "tensor_writer.h"
+#include <cassert>
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+std::vector<char> read(const std::string& path) {
+  std::ifstream file(path, std::ios::binary);
+  return std::vector<char>(std::istreambuf_iterator<char>(file), {});
+}
+int main(int argc, char** argv) {
+  std::string path = argv[1];
+  for (size_t size : {3, 4096, 4101}) {
+    { std::ofstream old(path); old << std::string(16384, 'x'); }
+    std::vector<char> data(size, 'a');
+    { AlignedBuffer buffer(path);
+      assert(buffer.writeData(data.data(), size) == size); }
+    auto actual = read(path);
+    size_t padded = (size + 4095) / 4096 * 4096;
+    assert(actual.size() == padded);
+    assert(std::equal(data.begin(), data.end(), actual.begin()));
+    for (size_t i = size; i < padded; ++i) assert(actual[i] == 0);
+  }
+  std::vector<char> first(4097, 'b'), second(4097, 'c');
+  { TensorWriter writer(path + ".tensor");
+    assert(writer.writeRecord(first.data(), first.size()) == 0);
+    assert(writer.writeRecord(second.data(), second.size()) == 8192); }
+  auto a = read(path + ".tensor_0"), b = read(path + ".tensor_1");
+  assert(a.size() == 8192 && b.size() == 8192);
+  assert(std::equal(first.begin(), first.end(), a.begin()));
+  assert(std::equal(second.begin(), second.end(), b.begin()));
+}
+""")
+            subprocess.run(["g++", "-std=c++17", str(work / "test.cpp"),
+                            str(work / "aligned_buffer.cpp"),
+                            str(work / "tensor_writer.cpp"), "-o",
+                            str(work / "test")], check=True, timeout=30)
+            subprocess.run([str(work / "test"), str(work / "payload")],
+                           check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    unittest.main()
-- 
